# Renders & work artifacts (large, regenerable)
projects/*/renders/
projects/*/work/
projects/*/runs/
**/renders/
**/work/
**/runs/
*.mp4
*.mov
*.webm
*.wav
*.mp3

# Build/cache artifacts from the fast-render + frame-cache pipeline (regenerable)
**/.framecache/
**/*.precompiled.html
**/*.precompiled.js
# keep small sample outputs if you force-add: git add -f path

# Node / HyperFrames
node_modules/
.DS_Store
*.log

# Whisper / python caches
__pycache__/
*.pyc
.cache/

# Allow templates, fonts, scripts, prompts, docs, md files
!templates/**
!assets/fonts/**
!scripts/**
!prompts/**

# SFX pack (small, reusable engine assets)
!sfx/**

# whisperX venv (1.3GB, recreated via setup)
.venv-whisperx/

# Secrets / API credentials
.env
.env.*

# per-project font copies (duplicates of shared assets/fonts/, regenerated at render time)
projects/*/assets/fonts/
